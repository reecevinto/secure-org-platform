# Secure Organization Management Platform
# Local development configuration template
# Do not place real secrets in this file.

APP_NAME="Secure Organization Management Platform"
APP_ENV="development"
DEBUG=false

DATABASE_URL="postgresql+psycopg://secure_org:<password>@localhost:5433/secure_org_platform"

MFA_ENCRYPTION_KEY="<generate-a-local-fernet-key>"

# Password recovery
PASSWORD_RECOVERY_TOKEN_TTL_SECONDS=1800

# Password-recovery rate limiting
# Generate a dedicated random secret of at least 32 bytes.
# Do not reuse the MFA encryption key or commit a real secret.
PASSWORD_RECOVERY_RATE_LIMIT_HMAC_KEY="<generate-a-dedicated-random-secret-of-at-least-32-bytes>"
PASSWORD_RECOVERY_SOURCE_RATE_LIMIT=10
PASSWORD_RECOVERY_SOURCE_WINDOW_SECONDS=900
PASSWORD_RECOVERY_EMAIL_RATE_LIMIT=3
PASSWORD_RECOVERY_EMAIL_WINDOW_SECONDS=3600
PASSWORD_RESET_SOURCE_RATE_LIMIT=10
PASSWORD_RESET_SOURCE_WINDOW_SECONDS=900
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# SMTP delivery
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
